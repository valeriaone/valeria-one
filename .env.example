# Copy to .env and fill in. Never commit .env.
# docker compose: database password
VO_DB_PASSWORD=CHANGE_ME
VO_DATABASE_URL=postgresql+psycopg://vo:CHANGE_ME@localhost:5432/valeria_one
VO_TEST_DATABASE_URL=postgresql+psycopg://vo:CHANGE_ME@localhost:5432/valeria_one_test
# Fernet key for channel secrets: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VO_SECRET_KEY=
VO_PUBLIC_URL=https://your-domain.example
# 1 = sandbox server: fake 'sandbox' channel only, self-serve /v1/sandbox/signup
VO_SANDBOX=0
# closed = only the first account (/setup) and people invited; open = anyone can create a business
VO_SIGNUP=closed
# docker compose (deploy/install.sh writes these): project name, your domain (HTTPS by Caddy), ports
COMPOSE_PROJECT_NAME=valeria-one
VO_DOMAIN=
VO_HTTP_PORT=80
VO_HTTPS_PORT=443
VO_HTTP_BIND=0.0.0.0
# where the host keeps backups and talks to the Server page (installs: /opt/valeria-one/…)
VO_HOST_BACKUPS=./.data/backups
VO_HOST_OPS=./.data/ops
VO_BACKUP_KEEP=14
VO_GRAPH_VERSION=v23.0
# Meta one-click connection (see docs/META_SETUP.md); leave empty to keep it off
VO_META_APP_ID=
VO_META_APP_SECRET=
VO_META_VERIFY_TOKEN=
VO_META_WA_CONFIG_ID=
VO_META_LOGIN_CONFIG_ID=
# Google Calendar two-way sync (OAuth client, type Web application,
# redirect URI https://YOUR-SERVER/app/calendar/google/callback); run `python -m valeria_one.jobs calendar` every minute
VO_GOOGLE_CLIENT_ID=
VO_GOOGLE_CLIENT_SECRET=
# Sandbox only: the operator's demo AI for demo businesses (capped per day); comma-separated models = fallbacks
VO_DEMO_AI_PROVIDER=
VO_DEMO_AI_KEY=
VO_DEMO_AI_MODEL=
VO_DEMO_AI_DAILY=100
