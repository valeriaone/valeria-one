# Copy to .env and fill in. Never commit .env.
# docker compose: database password
VO_DB_PASSWORD=CHANGE_ME
VO_DATABASE_URL=postgresql+psycopg://vo:CHANGE_ME@localhost:5432/valeria_one
VO_TEST_DATABASE_URL=postgresql+psycopg://vo:CHANGE_ME@localhost:5432/valeria_one_test
# Fernet key for channel secrets: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VO_SECRET_KEY=
VO_PUBLIC_URL=https://your-domain.example
# 1 = sandbox server: fake 'sandbox' channel only, self-serve /v1/sandbox/signup
VO_SANDBOX=0
# closed = only the first account (/setup) and people invited; open = anyone can create a business
VO_SIGNUP=closed
# docker compose (deploy/install.sh writes these): project name, your domain (HTTPS by Caddy), ports
COMPOSE_PROJECT_NAME=valeria-one
VO_DOMAIN=
VO_HTTP_PORT=80
VO_HTTPS_PORT=443
VO_HTTP_BIND=0.0.0.0
# where the host keeps backups and talks to the Server page (installs: /opt/valeria-one/…)
VO_HOST_BACKUPS=./.data/backups
VO_HOST_OPS=./.data/ops
VO_BACKUP_KEEP=14
VO_GRAPH_VERSION=v23.0
# Meta one-click connection (see docs/META_SETUP.md); leave empty to keep it off
VO_META_APP_ID=
VO_META_APP_SECRET=
VO_META_VERIFY_TOKEN=
VO_META_WA_CONFIG_ID=
VO_META_LOGIN_CONFIG_ID=
# "Continue with Facebook" (optional; else VO_META_LOGIN_CONFIG_ID): redirect URI https://YOUR-SERVER/auth/facebook/callback
VO_META_SIGNUP_CONFIG_ID=
# Google Calendar two-way sync + "Continue with Google" (OAuth client, type Web application, redirect URIs
# https://YOUR-SERVER/app/calendar/google/callback and https://YOUR-SERVER/auth/google/callback);
# run `python -m valeria_one.jobs calendar` every minute
VO_GOOGLE_CLIENT_ID=
VO_GOOGLE_CLIENT_SECRET=
# Google Business Profile with the same client (reviews, posts, insights; redirect URI
# https://YOUR-SERVER/app/google/callback). See docs/GOOGLE_SETUP.md. Off unless "on".
VO_GOOGLE_BUSINESS=off
# on while the Google app is in Testing mode (Google ends access every 7 days: owners are reminded)
VO_GOOGLE_OAUTH_TESTING=on
# Posts: label AI-written Instagram posts with is_ai_generated (only if your Graph version accepts it)
VO_META_AI_LABEL=off
# TikTok inbox (Business Messaging API), see docs/TIKTOK_SETUP.md; leave empty to keep it off
VO_TIKTOK_APP_ID=
VO_TIKTOK_APP_SECRET=
# Sandbox only: the operator's demo AI for demo businesses (capped per day); comma-separated models = fallbacks
VO_DEMO_AI_PROVIDER=
VO_DEMO_AI_KEY=
VO_DEMO_AI_MODEL=
VO_DEMO_AI_DAILY=100
# The server's own email (password resets, billing notices); empty = nothing sent
VO_SMTP_HOST=
VO_SMTP_PORT=587
VO_SMTP_USER=
VO_SMTP_PASSWORD=
VO_SMTP_FROM=
VO_SMTP_FROM_NAME=Valeria One
# Charging for Valeria One as a hosted service (self-hosted: leave off). See docs/SELF_HOST.md
VO_BILLING=off
VO_SELLER_COUNTRY=
VO_PRICES=
VO_STRIPE_SECRET_KEY=
VO_STRIPE_WEBHOOK_SECRET=
VO_REFERRAL_PERCENT=30
VO_BADGE=on
# Public pages of a service selling Valeria One (home, /mx, trade and competitor pages, legal drafts)
VO_MARKETING=off

# Canva (design studio): the server's Canva app, see docs/CANVA_SETUP.md
VO_CANVA_CLIENT_ID=
VO_CANVA_CLIENT_SECRET=

# Valeria, the owner's assistant (v0.13): no settings here. Each business uses its own WhatsApp/Telegram, its own AI key
# (Settings › AI) and its own payment account; the jobs step `assistant` does the rest. Helpers sign up at /helpers.
