# Copy to .env and fill in. Never commit .env.
# docker compose: database password
VO_DB_PASSWORD=CHANGE_ME
VO_DATABASE_URL=postgresql+psycopg://vo:CHANGE_ME@localhost:5432/valeria_one
VO_TEST_DATABASE_URL=postgresql+psycopg://vo:CHANGE_ME@localhost:5432/valeria_one_test
# Fernet key for channel secrets: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VO_SECRET_KEY=
VO_PUBLIC_URL=https://your-domain.example
# 1 = sandbox server: fake 'sandbox' channel only, self-serve /v1/sandbox/signup
VO_SANDBOX=0
VO_GRAPH_VERSION=v23.0
